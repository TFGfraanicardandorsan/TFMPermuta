NODE_ENV=production
PORT=3000
BIND_HOST=127.0.0.1
# Si el proxy está en el mismo equipo; no usar true ni 1.
TRUST_PROXY=loopback
PUBLIC_BASE_URL=https://permutas.eii.us.es
FRONTEND_ORIGINS=https://permutas.eii.us.es
ENABLE_API_DOCS=false
# Peticiones por minuto: por IP (alto, el campus comparte IP pública) y por usuario autenticado.
RATE_LIMIT_IP_PER_MIN=3000
RATE_LIMIT_USER_PER_MIN=300

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tfmpermuta
DB_USER=tfmpermuta_app
DB_PASS=
# Activar con CA válida cuando PostgreSQL esté en otra máquina.
DB_SSL=false
DB_SSL_CA=

# Generar con node scripts/rotate-security-secrets.mjs (con .env creado).
SESSION_SECRET=
# Clave nueva; la clave anteriormente versionada será rechazada.
SSL_KEY_PATH=/etc/tfmpermuta/tls/privkey.pem
SSL_CERT_PATH=/etc/tfmpermuta/tls/fullchain.pem
# Solo mientras no haya certificado nuevo: aceptar explícitamente la clave que estuvo en Git
# (su huella SPKI SHA-256). Quitar en cuanto se instale el certificado reemitido.
# TLS_ACCEPT_EXPOSED_KEY_SHA256=59b4812d8af74ef8853ef95eda9a3a7115ffa7c7844ce7245fb71afbf2459c7f
SSL_PASSPHRASE=
SIMPLESAML_AUTH_URL=https://permutas.eii.us.es/simplesaml/module.php/core/authenticate.php?as=default-sp
SIMPLESAML_COOKIE_NAMES=SimpleSAMLSessionID,SimpleSAML,SimpleSAMLAuthToken,PHPSESSID
# Opcional: por defecto se deduce as_login.php?AuthId=default-sp a partir de SIMPLESAML_AUTH_URL.
# SIMPLESAML_LOGIN_URL=

BUZON=/var/lib/tfmpermuta/buzon
ARCHIVADOR=/var/lib/tfmpermuta/archivador
PROYECTO_DOCENTE=/var/lib/tfmpermuta/proyecto-docente
PLANTILLAS=/var/lib/tfmpermuta/plantillas
DELEGADOS_CERTIFICADOS_DIR=/var/lib/tfmpermuta/delegados
PDF_FOLDER=/var/lib/tfmpermuta/archivador

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_CHAT_ID=
EMAIL_USERNAME=
EMAIL_PASSWORD=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_ALLOWED_HOSTS=smtp.office365.com
SMTP_USER=
SMTP_PASSWORD=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://permutas.eii.us.es/api/v1/delegados/microsoft/callback

PROPUESTAS_PERMUTA_HABILITADAS=true
PROPUESTAS_PERMUTA_AL_INICIO=false
PROPUESTAS_PERMUTA_INTERVALO_MS=300000
# Red de seguridad del cálculo de emparejamientos (se ejecuta en un worker_thread)
EMPAREJAMIENTO_TIEMPO_MAXIMO_MS=60000
